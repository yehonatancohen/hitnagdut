# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — contains API keys, never commit
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local settings
.claude/

# Backend lives in a separate repo
/backend/

# Sensitive data — PDF inputs and Excel outputs are private client documents
results/inputs/*
results/output/*
results/manual_result/*
!results/inputs/.gitkeep
!results/output/.gitkeep
!results/manual_result/.gitkeep

# Temp files generated by pipeline scripts
scripts/_tmp_*.json

.vercel
