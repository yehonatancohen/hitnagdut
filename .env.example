# ── Clerk Authentication ──────────────────────────────────────────────────────
# Get from: https://dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk redirect URLs (leave as-is for local dev)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Clerk Webhook secret — get from: Clerk Dashboard → Webhooks → your endpoint → Signing Secret
# Required events to enable: user.created, user.updated, user.deleted
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Backend (Oracle Cloud machine) ───────────────────────────────────────────
# The FastAPI service running on your backend machine
BACKEND_URL=http://130.110.238.248:8000

# Shared secret between Next.js and FastAPI — must match backend .env
BACKEND_API_KEY=your-random-32-char-secret-here

# ── PostgreSQL (running on backend machine) ───────────────────────────────────
DATABASE_URL=postgresql://hitnagdut:YOUR_DB_PASSWORD@130.110.238.248:5432/hitnagdut
